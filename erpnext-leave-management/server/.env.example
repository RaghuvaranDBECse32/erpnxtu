PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Demo Mode: true for in-memory simulated environment, false for live
DEMO_MODE=true
PAYMENT_MODE=demo

# Razorpay credentials (leave empty in DEMO_MODE)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Exasol Personal credentials (leave empty to fallback to in-memory store)
EXASOL_HOST=
EXASOL_PORT=8563
EXASOL_USER=sys
EXASOL_PASSWORD=
EXASOL_DATABASE=RECOVERAI

# Optional AI API Key (e.g. for LLM recovery enrichment)
AI_API_KEY=
